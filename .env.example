MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bootstrap admin. This does not create jobs.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional generic names. A source uses these only when its apiKeyEnv / appIdEnv point here.
JOB_SOURCE_API_KEY=
JOB_SOURCE_APP_ID=

# Provider credentials. Set the ones for sources you enable.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Required for /api/cron/* on Vercel, a VPS crontab, or another scheduler.
CRON_SECRET=

# Optional job-alert email. Alerts are saved even when these are empty.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
